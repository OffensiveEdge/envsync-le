# Tricky cases: pins current parser behavior, bugs included
export EXPORTED_KEY=value
MULTILINE="line one
line two"
NO_EQUALS_LINE
=value_without_key
KEY WITH SPACES=value
INVALID!CHARS=value
lowercase_key=ok
DASH-KEY=allowed
DUPLICATE=first
DUPLICATE=second
SPACED_KEY = spaced value
	TAB_INDENTED=value
INLINE_COMMENT=value # trailing comment
QUOTED_HASH="value # not a comment"
